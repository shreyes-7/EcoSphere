!- Windows Line endings 

Building,
    Baseline Office,          !- Name
    0,                        !- North Axis
    Suburbs,                  !- Terrain
    0.04,                     !- Loads Convergence Tolerance Value
    0.4,                      !- Temperature Convergence Tolerance Value
    FullExterior,             !- Solar Distribution
    25,                       !- Maximum Number of Warmup Days
    6;                        !- Minimum Number of Warmup Days

People,
    OfficeOccupants,          !- Name
    Zone1,                    !- Zone or ZoneList Name
    OccupancySchedule,        !- Number of People Schedule Name
    People/Area,              !- Number of People Calculation Method
    ,                         !- Number of People
    0.09408;                  !- People per Zone Floor Area

Lights,
    OfficeLights,             !- Name
    Zone1,                    !- Zone or ZoneList Name
    LightingSchedule,         !- Schedule Name
    Watts/Area,               !- Design Level Calculation Method
    ,                         !- Lighting Level
    8.55;                     !- Watts per Zone Floor Area

HVACTemplate:Thermostat,
    Thermostat1,              !- Name
    ,                         !- Heating Setpoint Schedule Name
    20,                       !- Constant Heating Setpoint
    ,                         !- Cooling Setpoint Schedule Name
    23;                       !- Constant Cooling Setpoint