# ==============================================================================
# EcoSphere: Autonomous Building Energy Optimization & Multi-Agent Management
# Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env' in the project root directory and update as needed.
# DO NOT COMMIT THE ACTUAL '.env' FILE TO GIT!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Platform Core & Server Settings
# ------------------------------------------------------------------------------
APP_NAME="EcoSphere"
APP_VERSION="1.0.0"
DEBUG="false"
HOST="127.0.0.1"
PORT=8000
LOG_LEVEL="INFO"
LOG_FILE="logs/ecosphere.log"

# ------------------------------------------------------------------------------
# 2. Database Connection
# -------------------------------- agreed to use SQLite default
DATABASE_URL="sqlite:///backend/database/ecosphere.db"

# ------------------------------------------------------------------------------
# 3. EnergyPlus Physics Engine Settings
# ------------------------------------------------------------------------------
# Leave empty for automatic auto-detection of system EnergyPlus installations,
# or specify the absolute path to your EnergyPlus executable/folder (e.g. C:\EnergyPlusV23-2-0)
ENERGYPLUS_PATH=""
BUILDING_IDF="energyplus/building.idf"
WEATHER_FILE="weather/weather.epw"
OUTPUT_DIRECTORY="energyplus/output"
UPLOAD_DIRECTORY="uploads"
SIMULATION_TIMEOUT_SECONDS=600

# ------------------------------------------------------------------------------
# 4. Ollama Local LLM & AI Facility Manager Assistant
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5-coder:3b"
OLLAMA_TIMEOUT_SECONDS=60

# ------------------------------------------------------------------------------
# 5. Multi-Agent Building Guardrails & ASHRAE-55 Thermal Limits
# ------------------------------------------------------------------------------
TARGET_TEMPERATURE_MIN=22.0
TARGET_TEMPERATURE_MAX=25.0
TARGET_HUMIDITY_MIN=40.0
TARGET_HUMIDITY_MAX=60.0
TARGET_PMV_MIN=-0.5
TARGET_PMV_MAX=0.5
HIGH_HVAC_ENERGY_THRESHOLD=100.0
HIGH_CARBON_INTENSITY_THRESHOLD=0.4
ENERGY_PRICE_PER_KWH=0.12
CARBON_KG_PER_KWH=0.4
MAX_EXPECTED_SAVINGS_PERCENT=25.0
